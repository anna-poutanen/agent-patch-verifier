{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-patch-verifier:evidence-plan:2",
  "title": "Agent Patch Verifier evidence plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "requirements", "cases"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1, 2]
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "kind",
          "provenance",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "statement": {
            "type": "string",
            "pattern": "\\S"
          },
          "kind": {
            "enum": ["requested", "preservation"]
          },
          "provenance": {
            "enum": ["explicit", "preexisting", "inferred"]
          },
          "source": {
            "type": "string",
            "pattern": "\\S"
          },
          "excerpt": {
            "type": ["string", "null"]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "provenance": {
                  "const": "explicit"
                }
              },
              "required": ["provenance"]
            },
            "then": {
              "required": ["excerpt"],
              "properties": {
                "source": {
                  "pattern": "^[iI][sS][sS][uU][eE](?:\\.[mM][dD])?:[1-9][0-9]*$"
                },
                "excerpt": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "provenance": {
                  "const": "preexisting"
                }
              },
              "required": ["provenance"]
            },
            "then": {
              "required": ["excerpt"],
              "properties": {
                "source": {
                  "pattern": "^.+:0*[1-9][0-9]*$"
                },
                "excerpt": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requirement_id", "test_file", "node"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "requirement_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "test_file": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\.py$"
          },
          "node": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)*$"
          },
          "rationale": {
            "type": "string"
          },
          "test_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": 2}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "cases": {
            "items": {"required": ["test_sha256"]}
          }
        }
      },
      "else": {
        "properties": {
          "cases": {
            "items": {"not": {"required": ["test_sha256"]}}
          }
        }
      }
    }
  ]
}

