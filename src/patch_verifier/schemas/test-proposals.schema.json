{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-patch-verifier:test-proposals:1",
  "title": "Agent Patch Verifier review-only test proposals",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "review_status",
    "reviewed_requirements",
    "generator",
    "generator_response",
    "coverage",
    "proposals"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "test-proposals"},
    "review_status": {"const": "requires_review"},
    "reviewed_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "schema_version",
        "requirement_count",
        "requirement_ids"
      ],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": 1},
        "requirement_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/requirement_id"}
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "model"],
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "model": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "\\S"
            },
            {"type": "null"}
          ]
        }
      }
    },
    "generator_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "sha256", "canonical_sha256"],
      "properties": {
        "binding": {"enum": ["canonical", "exact"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposed_requirement_ids", "unproposed_requirement_ids"],
      "properties": {
        "proposed_requirement_ids": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/requirement_id"}
        },
        "unproposed_requirement_ids": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/requirement_id"}
        }
      }
    },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {"$ref": "#/$defs/proposal"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requirement_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^case-[0-9a-f]{59}$"
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "kind",
        "provenance",
        "source",
        "excerpt"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/requirement_id"},
        "statement": {
          "type": "string",
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "kind": {"enum": ["requested", "preservation"]},
        "provenance": {"enum": ["explicit", "preexisting", "inferred"]},
        "source": {
          "type": "string",
          "maxLength": 4128,
          "pattern": "\\S"
        },
        "excerpt": {
          "type": ["string", "null"],
          "maxLength": 16000
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "sha256"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2097152
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "requirement",
        "start_line",
        "end_line",
        "start_column",
        "end_column",
        "excerpt",
        "sha256"
      ],
      "properties": {
        "kind": {"const": "python_assert"},
        "requirement": {"$ref": "#/$defs/requirement"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "start_column": {"type": "integer", "minimum": 0},
        "end_column": {"type": "integer", "minimum": 0},
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2097152
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirement_id",
        "category",
        "test_file",
        "node",
        "rationale",
        "review_status",
        "source",
        "assertion"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/case_id"},
        "requirement_id": {"$ref": "#/$defs/requirement_id"},
        "category": {
          "enum": [
            "requested",
            "preservation",
            "boundary",
            "invalid_input",
            "caller_level",
            "state_sequence"
          ]
        },
        "test_file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\.py$"
        },
        "node": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "review_status": {"const": "requires_review"},
        "source": {"$ref": "#/$defs/source"},
        "assertion": {"$ref": "#/$defs/assertion"}
      }
    }
  }
}
