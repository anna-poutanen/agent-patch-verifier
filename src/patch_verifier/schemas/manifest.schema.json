{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-patch-verifier:manifest:2",
  "title": "Agent Patch Verifier evidence bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "run_id",
    "created_at",
    "repository",
    "requested_base_revision",
    "base_commit",
    "patched_tree",
    "patch_sha256",
    "issue_sha256",
    "evidence_plan_sha256",
    "results_sha256",
    "context_sha256",
    "harness_sha256",
    "report_sha256",
    "environment",
    "execution",
    "scope",
    "requirements",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "agent-patch-verifier"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[A-Za-z0-9.+-]*)?$"
        }
      }
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "requested_base_revision": {
      "type": "string",
      "pattern": "\\S"
    },
    "base_commit": {
      "$ref": "#/$defs/gitObjectId"
    },
    "patched_tree": {
      "$ref": "#/$defs/gitObjectId"
    },
    "patch_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "issue_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "evidence_plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "results_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "context_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "harness_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "report_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_executable", "python_version", "platform"],
      "properties": {
        "python_executable": {
          "type": "string",
          "minLength": 1
        },
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_prefix",
        "timeout_seconds",
        "repeat",
        "output_limit_bytes_per_stream",
        "warning"
      ],
      "properties": {
        "command_prefix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "output_limit_bytes_per_stream": {
          "const": 250000
        },
        "warning": {
          "const": "Local subprocess execution is not a security sandbox."
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed_files", "changed_symbols"],
      "properties": {
        "changed_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/changedFile"
          }
        },
        "changed_symbols": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/changedSymbol"
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitObjectId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_line", "end_line"],
      "properties": {
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "kind",
        "provenance",
        "source",
        "excerpt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "statement": {
          "type": "string",
          "pattern": "\\S"
        },
        "kind": {
          "enum": ["requested", "preservation"]
        },
        "provenance": {
          "enum": ["explicit", "preexisting", "inferred"]
        },
        "source": {
          "type": "string",
          "pattern": "\\S"
        },
        "excerpt": {
          "type": ["string", "null"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "explicit"
              }
            },
            "required": ["provenance"]
          },
          "then": {
            "properties": {
              "source": {
                "pattern": "^[iI][sS][sS][uU][eE](?:\\.[mM][dD])?:[1-9][0-9]*$"
              },
              "excerpt": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "preexisting"
              }
            },
            "required": ["provenance"]
          },
          "then": {
            "properties": {
              "source": {
                "pattern": "^.+:0*[1-9][0-9]*$"
              },
              "excerpt": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "changedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["old_path", "new_path", "old_lines", "new_lines"],
      "properties": {
        "old_path": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "new_path": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "old_lines": {
          "$ref": "#/$defs/sourceLines"
        },
        "new_lines": {
          "$ref": "#/$defs/sourceLines"
        }
      },
      "anyOf": [
        {
          "properties": {
            "old_path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["old_path"]
        },
        {
          "properties": {
            "new_path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["new_path"]
        }
      ]
    },
    "sourceLines": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "changedSymbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "qualified_name",
        "kind",
        "base_span",
        "patched_span",
        "removed_lines",
        "added_lines",
        "base_path",
        "patched_path",
        "base_occurrence",
        "patched_occurrence",
        "revision_match"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "qualified_name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["module", "class", "function", "async_function"]
        },
        "base_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/span"
            },
            {
              "type": "null"
            }
          ]
        },
        "patched_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/span"
            },
            {
              "type": "null"
            }
          ]
        },
        "removed_lines": {
          "$ref": "#/$defs/sourceLines"
        },
        "added_lines": {
          "$ref": "#/$defs/sourceLines"
        },
        "base_path": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "patched_path": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "base_occurrence": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "patched_occurrence": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "revision_match": {
          "enum": [
            "unique",
            "module",
            "unique_identity",
            "base_only",
            "patched_only",
            "ambiguous_duplicate_unpaired",
            "path_change_module",
            "path_change_unique_identity",
            "path_change_base_only",
            "path_change_patched_only",
            "path_change_ambiguous_duplicate_unpaired"
          ]
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirement_id",
        "injected_path",
        "test_sha256",
        "command",
        "finding"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "requirement_id": {
          "$ref": "#/$defs/identifier"
        },
        "injected_path": {
          "type": "string",
          "pattern": "^\\.patch_verifier_generated_[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}/test_[A-Za-z0-9_]+_[0-9a-f]{8}\\.py$"
        },
        "test_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "command": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string"
          }
        },
        "finding": {
          "enum": [
            "supported_regression",
            "review_only_change",
            "incomplete_fix",
            "criterion_passes",
            "preserved",
            "no_differential",
            "inconclusive"
          ]
        }
      }
    }
  }
}
