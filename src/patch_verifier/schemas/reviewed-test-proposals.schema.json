{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-patch-verifier:reviewed-test-proposals:1",
  "title": "Agent Patch Verifier reviewed test proposals",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "proposal_artifact",
    "reviewed_requirements",
    "issue",
    "generator_response",
    "review",
    "coverage",
    "requirements",
    "cases",
    "accepted_cases",
    "audit"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "artifact_type": {"const": "reviewed-test-proposals"},
    "proposal_artifact": {"$ref": "#/$defs/proposal_binding"},
    "reviewed_requirements": {"$ref": "#/$defs/requirements_binding"},
    "issue": {"$ref": "#/$defs/issue_binding"},
    "generator_response": {"$ref": "#/$defs/response_binding"},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "schema_version"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"type": "integer", "const": 1}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted_requirement_ids", "unaccepted_requirement_ids"],
      "properties": {
        "accepted_requirement_ids": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/requirement_id"}
        },
        "unaccepted_requirement_ids": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/requirement_id"}
        }
      }
    },
    "requirements": {
      "type": "array",
      "maxItems": 200,
      "items": {"$ref": "#/$defs/requirement"}
    },
    "cases": {
      "type": "array",
      "maxItems": 50,
      "items": {"$ref": "#/$defs/evidence_case"}
    },
    "accepted_cases": {
      "type": "array",
      "maxItems": 50,
      "items": {"$ref": "#/$defs/accepted_case"}
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_count", "accepted_count", "edited_count", "rejected_count", "decisions"],
      "properties": {
        "proposal_count": {"type": "integer", "minimum": 1, "maximum": 50},
        "accepted_count": {"type": "integer", "minimum": 0, "maximum": 50},
        "edited_count": {"type": "integer", "minimum": 0, "maximum": 50},
        "rejected_count": {"type": "integer", "minimum": 0, "maximum": 50},
        "decisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {"$ref": "#/$defs/terminal_decision"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "requirement_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "case_id": {"type": "string", "pattern": "^case-[0-9a-f]{59}$"},
    "proposal_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "schema_version", "proposal_count"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"type": "integer", "enum": [1, 2]},
        "proposal_count": {"type": "integer", "minimum": 1, "maximum": 50}
      }
    },
    "requirements_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "schema_version", "requirement_count", "requirement_ids"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"type": "integer", "enum": [1, 2]},
        "requirement_count": {"type": "integer", "minimum": 1, "maximum": 200},
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/requirement_id"}
        }
      }
    },
    "issue_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1, "maximum": 2097152}
      }
    },
    "response_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "sha256", "canonical_sha256", "supplied_sha256"],
      "properties": {
        "binding": {"enum": ["canonical", "exact"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "supplied_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "kind", "provenance", "source", "excerpt"],
      "properties": {
        "id": {"$ref": "#/$defs/requirement_id"},
        "statement": {"type": "string", "maxLength": 4000, "pattern": "\\S"},
        "kind": {"enum": ["requested", "preservation"]},
        "provenance": {"enum": ["explicit", "preexisting", "inferred"]},
        "source": {"type": "string", "maxLength": 4128, "pattern": "\\S"},
        "excerpt": {"type": ["string", "null"], "maxLength": 16000}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "sha256"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 2097152},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "requirement", "start_line", "end_line", "start_column", "end_column", "excerpt", "sha256"],
      "properties": {
        "kind": {"const": "python_assert"},
        "requirement": {"$ref": "#/$defs/requirement"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "start_column": {"type": "integer", "minimum": 0},
        "end_column": {"type": "integer", "minimum": 0},
        "excerpt": {"type": "string", "minLength": 1, "maxLength": 2097152},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement_id", "category", "test_file", "node", "rationale", "review_status", "source", "assertion"],
      "properties": {
        "id": {"$ref": "#/$defs/case_id"},
        "requirement_id": {"$ref": "#/$defs/requirement_id"},
        "category": {"enum": ["requested", "preservation", "boundary", "invalid_input", "caller_level", "state_sequence"]},
        "test_file": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\.py$"},
        "node": {"type": "string", "maxLength": 512, "pattern": "^[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)*$"},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S"},
        "review_status": {"const": "requires_review"},
        "source": {"$ref": "#/$defs/source"},
        "assertion": {"$ref": "#/$defs/assertion"}
      }
    },
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_file", "node", "rationale", "source"],
      "properties": {
        "test_file": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\.py$"},
        "node": {"type": "string", "maxLength": 512, "pattern": "^[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)*$"},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S"},
        "source": {"type": "string", "minLength": 1, "maxLength": 2097152}
      }
    },
    "terminal_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "proposal", "action", "rationale", "replacement"],
      "properties": {
        "proposal_id": {"$ref": "#/$defs/case_id"},
        "proposal": {"$ref": "#/$defs/proposal"},
        "action": {"enum": ["accept", "edit", "reject"]},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S"},
        "replacement": {
          "oneOf": [{"$ref": "#/$defs/replacement"}, {"type": "null"}]
        }
      }
    },
    "evidence_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement_id", "test_file", "node", "rationale", "test_sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/case_id"},
        "requirement_id": {"$ref": "#/$defs/requirement_id"},
        "test_file": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\.py$"},
        "node": {"type": "string", "maxLength": 512, "pattern": "^[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)*$"},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S"},
        "test_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "accepted_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_proposal_id", "review_action", "id", "requirement_id", "category", "test_file", "node", "rationale", "source", "assertion"],
      "properties": {
        "origin_proposal_id": {"$ref": "#/$defs/case_id"},
        "review_action": {"enum": ["accept", "edit"]},
        "id": {"$ref": "#/$defs/case_id"},
        "requirement_id": {"$ref": "#/$defs/requirement_id"},
        "category": {"enum": ["requested", "preservation", "boundary", "invalid_input", "caller_level", "state_sequence"]},
        "test_file": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\.py$"},
        "node": {"type": "string", "maxLength": 512, "pattern": "^[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)*$"},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S"},
        "source": {"$ref": "#/$defs/source"},
        "assertion": {"$ref": "#/$defs/assertion"}
      }
    }
  }
}
