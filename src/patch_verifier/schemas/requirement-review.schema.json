{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-patch-verifier:requirement-review:1",
  "title": "Agent Patch Verifier requirement review ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "draft",
    "conflict_analysis",
    "conflict_hints",
    "decisions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "requirement-review"},
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "schema_version", "candidate_count"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": 1},
        "candidate_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        }
      }
    },
    "conflict_hints": {
      "type": "array",
      "maxItems": 200,
      "items": {"$ref": "#/$defs/conflict_hint"}
    },
    "conflict_analysis": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/conflict_analysis"}
      ]
    },
    "decisions": {
      "type": "array",
      "maxItems": 500,
      "items": {"$ref": "#/$defs/decision"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^cand-[0-9a-f]{64}$"
    },
    "requirement_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "conflict_hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "candidate_ids", "message"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "candidate_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/candidate_id"}
        },
        "message": {
          "type": "string",
          "maxLength": 4000,
          "pattern": "\\S"
        }
      }
    },
    "conflict_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_candidate_count",
        "preservation_candidate_count",
        "compared_pair_count",
        "hint_count",
        "truncated"
      ],
      "properties": {
        "requested_candidate_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "preservation_candidate_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "compared_pair_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000
        },
        "hint_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "truncated": {"type": "boolean"}
      }
    },
    "candidate_preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "intent",
        "source_kind",
        "source",
        "review_status",
        "confidence",
        "rationale"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/candidate_id"},
        "statement": {
          "type": "string",
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "intent": {"enum": ["requested", "preservation"]},
        "source_kind": {
          "enum": ["issue", "pytest_assertion", "docstring"]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "start_line",
            "end_line",
            "start_column",
            "end_column",
            "excerpt",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "start_line": {"type": "integer", "minimum": 1},
            "end_line": {"type": "integer", "minimum": 1},
            "start_column": {"type": "integer", "minimum": 0},
            "end_column": {"type": "integer", "minimum": 0},
            "excerpt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            },
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "review_status": {"const": "requires_review"},
        "confidence": {"enum": ["high", "medium", "low"]},
        "rationale": {
          "type": "string",
          "maxLength": 4000,
          "pattern": "\\S"
        }
      }
    },
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "kind", "provenance"],
      "properties": {
        "statement": {
          "type": "string",
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "kind": {"enum": ["requested", "preservation"]},
        "provenance": {
          "enum": ["explicit", "preexisting", "inferred"]
        }
      }
    },
    "decision": {
      "oneOf": [
        {"$ref": "#/$defs/pending_decision"},
        {"$ref": "#/$defs/accept_decision"},
        {"$ref": "#/$defs/edit_decision"},
        {"$ref": "#/$defs/reject_decision"}
      ]
    },
    "decision_base": {
      "type": "object",
      "required": [
        "candidate_id",
        "candidate",
        "action",
        "requirement_id",
        "rationale",
        "replacement"
      ],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/candidate_id"},
        "candidate": {"$ref": "#/$defs/candidate_preview"},
        "action": {"enum": ["pending", "accept", "edit", "reject"]},
        "requirement_id": {
          "$ref": "#/$defs/requirement_id"
        },
        "rationale": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "replacement": {
          "oneOf": [
            {"$ref": "#/$defs/replacement"},
            {"type": "null"}
          ]
        }
      }
    },
    "pending_decision": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/decision_base"},
        {
          "type": "object",
          "properties": {
            "action": {"const": "pending"},
            "requirement_id": {"$ref": "#/$defs/requirement_id"},
            "rationale": {"type": "null"},
            "replacement": {"type": "null"}
          }
        }
      ]
    },
    "accept_decision": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/decision_base"},
        {
          "type": "object",
          "properties": {
            "action": {"const": "accept"},
            "requirement_id": {"$ref": "#/$defs/requirement_id"},
            "rationale": {
              "type": "string",
              "maxLength": 4000,
              "pattern": "\\S"
            },
            "replacement": {"type": "null"}
          }
        }
      ]
    },
    "edit_decision": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/decision_base"},
        {
          "type": "object",
          "properties": {
            "action": {"const": "edit"},
            "requirement_id": {"$ref": "#/$defs/requirement_id"},
            "rationale": {
              "type": "string",
              "maxLength": 4000,
              "pattern": "\\S"
            },
            "replacement": {"$ref": "#/$defs/replacement"}
          }
        }
      ]
    },
    "reject_decision": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/decision_base"},
        {
          "type": "object",
          "properties": {
            "action": {"const": "reject"},
            "requirement_id": {"$ref": "#/$defs/requirement_id"},
            "rationale": {
              "type": "string",
              "maxLength": 4000,
              "pattern": "\\S"
            },
            "replacement": {"type": "null"}
          }
        }
      ]
    }
  }
}
